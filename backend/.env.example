# Copy to .env and fill in. Never commit real values.

# local | development | test | production (default). Non-production adds a `debug` object
# (exception type and message) to error responses; never set it in a deployed environment.
APP_ENV=local

# Postgres (Supabase session pooler). API uses asyncpg; worker URL also feeds Procrastinate (psycopg).
DATABASE_URL=
WORKER_DATABASE_URL=
# API connection pool (Supabase's free session pooler allows few connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Supabase Storage (backend only; never sent to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=uploads
STORAGE_TIMEOUT_SECONDS=20
SIGNED_URL_TTL_SECONDS=600

# Clerk
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=
CLERK_CLOCK_SKEW_SECONDS=10
CLERK_JWKS_CACHE_SECONDS=3600
CLERK_JWKS_MIN_REFETCH_SECONDS=10
CLERK_JWKS_TIMEOUT_SECONDS=5

# LLM providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Model groups (comma-separated, in fallback order)
LLM_BULK_MODELS=groq/llama-3.3-70b-versatile,cerebras/llama-3.3-70b,gemini/gemini-flash-latest
LLM_INTERACTIVE_MODELS=groq/llama-3.3-70b-versatile,gemini/gemini-flash-latest
LLM_VERIFY_MODELS=gemini/gemini-flash-latest

# Embeddings (local fastembed, 384 dims)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Code execution for programming problems: judge0 | wasm
CODE_RUNNER=judge0
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Limits
MAX_PDF_PAGES=50
MAX_UPLOAD_MB=20
UPLOADS_PER_DAY=20

# Rate limits per user (in-memory; reset on restart)
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AI_PER_MIN=10
RATE_LIMIT_AI_PER_DAY=100

# Optional
SENTRY_DSN=
